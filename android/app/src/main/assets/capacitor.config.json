{
	"appId": "ph.edu.msu.classpulse",
	"appName": "ClassPulse 2.0",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"cleartext": true
	},
	"plugins": {
		"Keyboard": {
			"resize": "body",
			"style": "DARK"
		}
	},
	"android": {
		"allowMixedContent": true,
		"captureInput": true,
		"webContentsDebuggingEnabled": true
	},
	"ios": {
		"contentInset": "always",
		"preferredContentMode": "mobile"
	}
}
