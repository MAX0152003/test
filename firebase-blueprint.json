{
  "entities": {
    "ClassSession": {
      "title": "Class Session",
      "description": "Represents an academic course or laboratory class section",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "section": { "type": "string" },
        "schedule": { "type": "string" },
        "room": { "type": "string" },
        "facultyId": { "type": "string" },
        "facultyName": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["id", "code", "name"]
    },
    "AttendanceRecord": {
      "title": "Attendance Record",
      "description": "Log of student attendance for class sessions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "classId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentId": { "type": "string" },
        "status": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "classId", "studentId", "status", "date"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Real-time communication message across system users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "senderId", "text"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User account information and role assignments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "department": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "Student subject course enrollment records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "classId": { "type": "string" },
        "enrolledAt": { "type": "string" }
      },
      "required": ["id", "studentId", "classId"]
    },
    "LeaveRequest": {
      "title": "Excuse Letter / Leave Request",
      "description": "Student medical or academic excuse letters submitted to faculty",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" }
      },
      "required": ["id", "studentId", "classId", "reason", "status"]
    },
    "ConsultationBooking": {
      "title": "Consultation Booking",
      "description": "Student faculty consultation appointment booking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "facultyId": { "type": "string" },
        "facultyName": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "studentId", "facultyId", "date", "status"]
    }
  },
  "firestore": {
    "/classes/{classId}": {
      "schema": "ClassSession",
      "description": "Collection of academic class sessions"
    },
    "/records/{recordId}": {
      "schema": "AttendanceRecord",
      "description": "Collection of attendance logs"
    },
    "/attendance/{attendanceId}": {
      "schema": "AttendanceRecord",
      "description": "Collection of attendance records"
    },
    "/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Collection of chat communications"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection of registered user profiles"
    },
    "/registered_users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection of registered user accounts"
    },
    "/enrollments/{enrollmentId}": {
      "schema": "Enrollment",
      "description": "Collection of subject enrollments"
    },
    "/excuse_letters/{letterId}": {
      "schema": "LeaveRequest",
      "description": "Collection of student excuse letters"
    },
    "/excuseLetters/{letterId}": {
      "schema": "LeaveRequest",
      "description": "Legacy alias for student excuse letters"
    },
    "/consultation_bookings/{bookingId}": {
      "schema": "ConsultationBooking",
      "description": "Collection of consultation appointments"
    },
    "/consultations/{consultationId}": {
      "schema": "ConsultationBooking",
      "description": "Legacy alias for consultation appointments"
    }
  }
}
