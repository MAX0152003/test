rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------------
    // GLOBAL SECURITY & AUTHENTICATION HELPERS
    // --------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.role != null && request.auth.token.role == 'admin') ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'makil.fc515@s.msumain.edu.ph' ||
          request.auth.token.email.matches('^cics\\.admin.*@msumain\\.edu\\.ph$')
        ))
      );
    }

    function isFaculty() {
      return isAuthenticated() && (
        isAdmin() ||
        (request.auth.token.role != null && request.auth.token.role == 'faculty')
      );
    }

    // --------------------------------------------------------------------------
    // USERS, PROFILES, CREDENTIALS & PASSWORD RESETS
    // --------------------------------------------------------------------------

    match /users/{userId} {
      allow read, write: if true;
    }

    match /registered_users/{userId} {
      allow read, write: if true;
    }

    match /credentials/{credId} {
      allow read, write: if true;
    }

    match /password_resets/{resetId} {
      allow read, write: if true;
    }

    // --------------------------------------------------------------------------
    // ACADEMIC CLASSES & SCHEDULES
    // --------------------------------------------------------------------------

    match /classes/{classId} {
      allow read, write: if true;
    }

    // --------------------------------------------------------------------------
    // ATTENDANCE RECORDS & LOGS
    // --------------------------------------------------------------------------

    match /records/{recordId} {
      allow read, write: if true;
    }

    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    // --------------------------------------------------------------------------
    // SUBJECT ENROLLMENTS
    // --------------------------------------------------------------------------

    match /enrollments/{enrollmentId} {
      allow read, write: if true;
    }

    // --------------------------------------------------------------------------
    // EXCUSE LETTERS & LEAVE REQUESTS
    // --------------------------------------------------------------------------

    match /excuse_letters/{letterId} {
      allow read, write: if true;
    }

    match /excuseLetters/{letterId} {
      allow read, write: if true;
    }

    // --------------------------------------------------------------------------
    // CONSULTATION BOOKINGS & APPOINTMENTS
    // --------------------------------------------------------------------------

    match /consultation_bookings/{bookingId} {
      allow read, write: if true;
    }

    match /consultations/{consultationId} {
      allow read, write: if true;
    }

    // --------------------------------------------------------------------------
    // CHAT & MESSAGES
    // --------------------------------------------------------------------------

    match /messages/{messageId} {
      allow read, write: if true;
    }

    // --------------------------------------------------------------------------
    // FACULTY STATUSES, LAB ROOMS, & ANNOUNCEMENTS
    // --------------------------------------------------------------------------

    match /faculty_statuses/{facultyId} {
      allow read, write: if true;
    }

    match /rooms/{roomId} {
      allow read, write: if true;
    }

    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    match /session_links/{sessionId} {
      allow read, write: if true;
    }

    match /archivedTerms/{termId} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /test/{testId} {
      allow read, write: if true;
    }

    // --------------------------------------------------------------------------
    // CATCH-ALL FALLBACK
    // --------------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
