rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------------
    // GLOBAL SECURITY & AUTHENTICATION HELPERS
    // --------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return request.auth != null && (
        request.auth.token.email_verified == true ||
        request.auth.token.email == 'makil.fc515@s.msumain.edu.ph'
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.role != null && request.auth.token.role == 'admin') ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'makil.fc515@s.msumain.edu.ph' ||
          (request.auth.token.email.matches('^cics\\.admin.*@msumain\\.edu\\.ph$') && isVerifiedEmail())
        ))
      );
    }

    function isFaculty() {
      return isAuthenticated() && (
        isAdmin() ||
        (request.auth.token.role != null && request.auth.token.role == 'faculty')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // --------------------------------------------------------------------------
    // USERS, PROFILES, CREDENTIALS & PASSWORD RESETS
    // --------------------------------------------------------------------------

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 150 &&
        (!('role' in request.resource.data) || request.resource.data.role in ['student', 'faculty', 'admin']) &&
        (!('role' in request.resource.data) || request.resource.data.role != 'admin' || isAdmin());
      allow delete: if isAdmin();
    }

    match /registered_users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && (
        request.resource.data.name is string || request.resource.data.email is string
      ) &&
      (!('role' in request.resource.data) || request.resource.data.role != 'admin' || isAdmin());
      allow delete: if isAdmin();
    }

    match /credentials/{credId} {
      allow read: if true;
      allow create, update: if isValidId(credId) && request.resource.data.key is string;
      allow delete: if isAdmin();
    }

    match /password_resets/{resetId} {
      allow read, create, update: if isValidId(resetId);
      allow delete: if isAdmin();
    }

    // --------------------------------------------------------------------------
    // ACADEMIC CLASSES & SCHEDULES
    // --------------------------------------------------------------------------

    match /classes/{classId} {
      allow read: if true;
      allow create, update: if isValidId(classId) && (
        isFaculty() || isAdmin() || (
          request.resource.data.code is string &&
          request.resource.data.code.size() > 0 &&
          request.resource.data.code.size() <= 50 &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 200
        )
      );
      allow delete: if isFaculty() || isAdmin();
    }

    // --------------------------------------------------------------------------
    // ATTENDANCE RECORDS & LOGS
    // --------------------------------------------------------------------------

    match /records/{recordId} {
      allow read: if true;
      allow create: if isValidId(recordId) &&
        request.resource.data.classId is string &&
        request.resource.data.classId.size() > 0 &&
        request.resource.data.classId.size() <= 128 &&
        (request.resource.data.studentId is string || request.resource.data.studentName is string) &&
        (!('status' in request.resource.data) || request.resource.data.status in ['present', 'late', 'absent', 'excused']);
      allow update: if isFaculty() || isAdmin() || (
        resource.data.studentId == request.resource.data.studentId &&
        (!('status' in request.resource.data) || request.resource.data.status in ['present', 'late', 'absent', 'excused'])
      );
      allow delete: if isFaculty() || isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if true;
      allow create: if isValidId(attendanceId) &&
        request.resource.data.classId is string &&
        request.resource.data.classId.size() > 0;
      allow update, delete: if isFaculty() || isAdmin();
    }

    // --------------------------------------------------------------------------
    // SUBJECT ENROLLMENTS
    // --------------------------------------------------------------------------

    match /enrollments/{enrollmentId} {
      allow read: if true;
      allow create, update: if isValidId(enrollmentId) &&
        request.resource.data.classId is string &&
        request.resource.data.classId.size() > 0 &&
        request.resource.data.studentId is string &&
        request.resource.data.studentId.size() > 0;
      allow delete: if isFaculty() || isAdmin();
    }

    // --------------------------------------------------------------------------
    // EXCUSE LETTERS & LEAVE REQUESTS
    // --------------------------------------------------------------------------

    match /excuse_letters/{letterId} {
      allow read: if true;
      allow create: if isValidId(letterId) &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0 &&
        request.resource.data.studentId is string &&
        request.resource.data.studentId.size() > 0 &&
        (!('status' in request.resource.data) || request.resource.data.status == 'pending' || isFaculty() || isAdmin());
      allow update, delete: if isFaculty() || isAdmin();
    }

    match /excuseLetters/{letterId} {
      allow read: if true;
      allow create: if isValidId(letterId) &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0 &&
        request.resource.data.studentId is string &&
        request.resource.data.studentId.size() > 0 &&
        (!('status' in request.resource.data) || request.resource.data.status == 'pending' || isFaculty() || isAdmin());
      allow update, delete: if isFaculty() || isAdmin();
    }

    // --------------------------------------------------------------------------
    // CONSULTATION BOOKINGS & APPOINTMENTS
    // --------------------------------------------------------------------------

    match /consultation_bookings/{bookingId} {
      allow read: if true;
      allow create: if isValidId(bookingId) &&
        request.resource.data.studentId is string &&
        request.resource.data.studentId.size() > 0 &&
        request.resource.data.facultyId is string &&
        request.resource.data.facultyId.size() > 0;
      allow update, delete: if isFaculty() || isAdmin() || (
        resource.data.studentId == request.resource.data.studentId
      );
    }

    match /consultations/{consultationId} {
      allow read: if true;
      allow create: if isValidId(consultationId) &&
        request.resource.data.studentId is string &&
        request.resource.data.studentId.size() > 0 &&
        request.resource.data.facultyId is string &&
        request.resource.data.facultyId.size() > 0;
      allow update, delete: if isFaculty() || isAdmin() || (
        resource.data.studentId == request.resource.data.studentId
      );
    }

    // --------------------------------------------------------------------------
    // CHAT & MESSAGES
    // --------------------------------------------------------------------------

    match /messages/{messageId} {
      allow read: if true;
      allow create: if isValidId(messageId) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 2000;
      allow update, delete: if isFaculty() || isAdmin();
    }

    // --------------------------------------------------------------------------
    // FACULTY STATUSES, LAB ROOMS, & ANNOUNCEMENTS
    // --------------------------------------------------------------------------

    match /faculty_statuses/{facultyId} {
      allow read: if true;
      allow create, update: if isValidId(facultyId) && (
        isFaculty() || isAdmin() || (request.resource.data.name is string && request.resource.data.name.size() > 0)
      );
      allow delete: if isFaculty() || isAdmin();
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isFaculty() || isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isFaculty() || isAdmin();
    }

    match /session_links/{sessionId} {
      allow read: if true;
      allow create, update: if isValidId(sessionId);
      allow delete: if true;
    }

    match /archivedTerms/{termId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) &&
        request.resource.data.action is string &&
        request.resource.data.action.size() <= 250;
      allow update, delete: if isAdmin();
    }

    match /test/{testId} {
      allow read, write: if true;
    }

    // --------------------------------------------------------------------------
    // DEFAULT DENY ALL UNMATCHED PATHS
    // --------------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
