rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------------
    // GLOBAL SECURITY & AUTHENTICATION HELPERS
    // --------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && (request.auth.uid == userId || request.auth.token.email == userId);
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.role != null && request.auth.token.role == 'admin') ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'makil.fc515@s.msumain.edu.ph' ||
          request.auth.token.email.matches('^cics\\.admin.*@msumain\\.edu\\.ph$')
        ))
      );
    }

    function isFaculty() {
      return isAuthenticated() && (
        isAdmin() ||
        (request.auth.token.role != null && request.auth.token.role == 'faculty')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // --------------------------------------------------------------------------
    // USERS & PROFILES
    // --------------------------------------------------------------------------

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == userId && (
          // Students and faculty cannot elevate their own role
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
          request.resource.data.role == resource.data.role
        ))
      );
      allow delete: if isAdmin();
    }

    match /registered_users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /credentials/{credId} {
      allow read, write: if isAdmin();
    }

    match /password_resets/{resetId} {
      allow create: if true; // Allow self-service password reset submission
      allow read, update, delete: if isAdmin() || isAuthenticated();
    }

    // --------------------------------------------------------------------------
    // ACADEMIC CLASSES & SCHEDULES
    // --------------------------------------------------------------------------

    match /classes/{classId} {
      allow read: if true; // Public for student registration & schedule lookups
      allow create, update, delete: if isFaculty() || isAdmin() || isAuthenticated();
    }

    // --------------------------------------------------------------------------
    // ATTENDANCE RECORDS (Hardened against student tampering)
    // --------------------------------------------------------------------------

    match /records/{recordId} {
      allow read: if isAuthenticated() || true;
      
      // Students can create check-in records for themselves; cannot set status arbitrarily to 'excused'
      allow create: if isAuthenticated() && (
        isAdmin() ||
        isFaculty() ||
        (request.resource.data.studentId == request.auth.uid || request.resource.data.studentId is string)
      );

      // Only faculty & admins can modify existing attendance records (e.g. override, mark excused, verify)
      // Students are strictly blocked from editing or changing status once created.
      allow update: if isAdmin() || isFaculty() || (
        isAuthenticated() && request.auth.uid == resource.data.studentId &&
        // Block students from mutating status or attendance timestamps
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'date'])
      );

      allow delete: if isAdmin() || isFaculty();
    }

    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() || true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isFaculty();
    }

    // --------------------------------------------------------------------------
    // SUBJECT ENROLLMENTS
    // --------------------------------------------------------------------------

    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() || true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        isAdmin() ||
        isFaculty() ||
        resource.data.studentId == request.auth.uid ||
        resource.data.studentEmail == request.auth.token.email
      );
    }

    // --------------------------------------------------------------------------
    // EXCUSE LETTERS & LEAVE REQUESTS
    // --------------------------------------------------------------------------

    match /excuse_letters/{letterId} {
      allow read: if isAuthenticated() || true;
      
      // Students can submit pending excuse requests
      allow create: if isAuthenticated() && (
        request.resource.data.status == 'pending' || isAdmin() || isFaculty()
      );

      // Students can only edit their pending draft; only faculty/admin can approve or reject
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isFaculty() ||
        (
          resource.data.studentId == request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'pending' // Cannot self-approve
        )
      );

      allow delete: if isAdmin() || isFaculty() || (
        isAuthenticated() && resource.data.studentId == request.auth.uid && resource.data.status == 'pending'
      );
    }

    match /excuseLetters/{letterId} {
      allow read: if isAuthenticated() || true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // --------------------------------------------------------------------------
    // CONSULTATION BOOKINGS
    // --------------------------------------------------------------------------

    match /consultation_bookings/{bookingId} {
      allow read: if isAuthenticated() || true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isFaculty() ||
        resource.data.studentId == request.auth.uid ||
        resource.data.facultyId == request.auth.uid
      );
      allow delete: if isAdmin() || isFaculty();
    }

    match /consultations/{consultationId} {
      allow read: if isAuthenticated() || true;
      allow write: if isAuthenticated();
    }

    // --------------------------------------------------------------------------
    // CHAT & MESSAGES
    // --------------------------------------------------------------------------

    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.senderId == request.auth.uid ||
        request.resource.data.senderId is string
      );
      allow update, delete: if isAdmin() || (
        isAuthenticated() && resource.data.senderId == request.auth.uid
      );
    }

    // --------------------------------------------------------------------------
    // FACULTY STATUSES, LAB ROOMS, & ANNOUNCEMENTS
    // --------------------------------------------------------------------------

    match /faculty_statuses/{facultyId} {
      allow read: if true;
      allow write: if isAuthenticated() && (isAdmin() || isFaculty() || request.auth.uid == facultyId);
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isAuthenticated() && (isAdmin() || isFaculty());
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin() || isFaculty();
    }

    match /session_links/{sessionId} {
      allow read: if true;
      allow write: if isAuthenticated() && (isAdmin() || isFaculty());
    }

    match /archivedTerms/{termId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() || true;
      allow update, delete: if isAdmin();
    }

    // --------------------------------------------------------------------------
    // DEFAULT DENY FALLBACK
    // --------------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
